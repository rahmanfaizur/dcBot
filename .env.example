# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Optional: restrict slash-command registration to one guild while developing.
# Leave empty to register commands globally (can take up to an hour to propagate).
DISCORD_GUILD_ID=

# Linkdave audio server (required for music commands)
LINKDAVE_URL=ws://localhost:8080
LINKDAVE_PASSWORD=

# Optional: path to yt-dlp (auto-detected if unset; Docker compose sets yt-dlp)
# YTDLP_PATH=/snap/bin/yt-dlp

# Optional: path to ffmpeg (auto-detected if unset)
# FFMPEG_PATH=ffmpeg

# Logging: debug, info, warn, error
LOG_LEVEL=info
