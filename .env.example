# Copy to .env and fill in values. NEVER commit .env — it is gitignored.
#
# DISCORD_TOKEN and LINKDAVE_PASSWORD are secrets. Keep them only on your machine
# and on the deployment server (e.g. Azure VM). Do not paste them in issues, chats,
# or screenshots.

# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Optional: restrict slash-command registration to one guild while developing.
# Leave empty to register commands globally (can take up to an hour to propagate).
DISCORD_GUILD_ID=

# Linkdave audio server (required for music commands)
LINKDAVE_URL=ws://localhost:8080
LINKDAVE_PASSWORD=

# Optional: path to yt-dlp (auto-detected if unset; Docker compose sets yt-dlp)
# YTDLP_PATH=/snap/bin/yt-dlp

# Optional: path to ffmpeg (auto-detected if unset)
# FFMPEG_PATH=ffmpeg

# Logging: debug, info, warn, error
LOG_LEVEL=info

# Optional: Netscape-format YouTube cookies file.
#
# WARNING: leave this UNSET on cloud VMs. Measured on an Azure VM, cookies made
# YouTube playback strictly worse (0 of 5 tracks resolved with cookies, 1 of 5
# without) because YouTube treats a signed-in session from a datacenter IP as
# suspicious and withholds every audio format. Cookies only help on a home
# connection. Never commit this file.
# YTDLP_COOKIES_FILE=/run/secrets/youtube-cookies.txt

# --- Cloud VM (Azure): YouTube via WARP sidecar (recommended) ---
# 1. NEVER run: apt install cloudflare-warp / warp-cli mode warp / warp-cli connect
#    That hijacks the whole VM and breaks SSH.
# 2. Start WARP in Docker only:
#      docker compose --profile docker --profile warp up -d --build
# 3. Uncomment and set:
# YTDLP_PROXY=socks5://127.0.0.1:1080
# 4. Verify (safe — does not change host routing):
#      bash scripts/verify-warp.sh
#
# --- Public website (optional) ---
# Subdomain: music.frlabs.me  (keeps frlabs.me free for other projects)
#   1. Namecheap A record: music → VM public IP
#   2. Azure NSG: allow 80 + 443
#   3. Set invite URL in web/config.js
#   4. docker compose --profile docker --profile warp --profile web up -d --build
#
# --- MongoDB Atlas (live now-playing per Discord server) ---
# Put the real URI on the VM .env only — never commit it.
# Atlas Network Access must allow the VM (or 0.0.0.0/0 while testing).
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/frmusic?retryWrites=true&w=majority
# API_ADDR=127.0.0.1:8787
#
# --- Other proxies (home SOCKS, paid residential) ---
# YTDLP_PROXY=socks5://127.0.0.1:1080
